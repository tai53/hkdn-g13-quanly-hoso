# =====================================================================
# FILE MẪU CẤU HÌNH MÔI TRƯỜNG — được commit lên Git, KHÔNG chứa mật khẩu thật.
#
# Cách dùng:
#   1. Sao chép file này thành .env ở cùng thư mục (thư mục gốc project):
#        Git Bash / macOS / Linux:  cp .env.example .env
#        PowerShell:                Copy-Item .env.example .env
#   2. Mở .env và điền thông tin của bạn (ít nhất là 2 mật khẩu bên dưới).
#   3. KHÔNG commit file .env (đã có trong .gitignore).
#
# File .env được đọc bởi: docker-compose, backend (backend/src/config/env.js)
# và frontend (frontend/vite.config.js). Chỉ cần MỘT file .env ở thư mục gốc.
# =====================================================================

# --- PostgreSQL (dùng cho cả Cách A và Cách B) ---
DB_USER=postgres
# Tự đặt mật khẩu cho database trên máy bạn.
# Lưu ý: mật khẩu chỉ được áp dụng lúc tạo DB lần đầu. Đổi sau đó phải tạo lại DB
# (docker compose down -v), xem docs/HUONG_DAN_CAI_DAT.md mục 9.3.
DB_PASSWORD=doi_mat_khau_nay
DB_NAME=quanly_hoso
# Cổng PostgreSQL mở ra máy host. Đổi (vd: 5433) nếu máy đã cài sẵn PostgreSQL.
DB_PORT=5432
# Chỉ dùng khi chạy backend trực tiếp trên máy (Cách B): để localhost.
# Chạy bằng Docker (Cách A), docker-compose tự đặt DB_HOST=db, giá trị này bị bỏ qua.
DB_HOST=localhost

# --- Backend ---
NODE_ENV=development
# Cổng backend khi chạy trên máy (Cách B). Cách A dùng BACKEND_PORT bên dưới.
PORT=5000
# Origin frontend được gọi API khi chạy Cách B (frontend chạy trên máy luôn ở cổng 5173).
# Cách A: docker-compose tự đặt theo FRONTEND_PORT.
CORS_ORIGIN=http://localhost:5173

# --- Frontend ---
# Địa chỉ API khi chạy frontend trên máy (Cách B). Cổng phải trùng với PORT ở trên.
# Cách A: docker-compose tự đặt theo BACKEND_PORT.
VITE_API_URL=http://localhost:5000/api

# --- Cổng mở ra máy host khi chạy bằng Docker (Cách A) ---
BACKEND_PORT=5000
FRONTEND_PORT=5173

# --- pgAdmin (chỉ chạy khi dùng: docker compose --profile tools up -d) ---
# Email đăng nhập pgAdmin, phải đúng định dạng email (không cần là email thật).
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=doi_mat_khau_nay
PGADMIN_PORT=5050
